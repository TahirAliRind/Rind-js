      {
        TAG-button,
        TEXT-"🔔 " + STATE.notifications,
        PA-8px 14px,
        BG-#1e293b,
        COL-#ffffff,
        BOR-20px,
        CUR-pointer,
        BO-none,
        FON-0.9rem,
        ONCLICK-clearNotifications
      },
      {
        DI-flex,
        ALI-center,
