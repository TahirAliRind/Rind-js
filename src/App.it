        { USE-Card, TITLE-"Beautiful UI", BODY-"Ek short syntax se poori modern website bana sakte hain.", ICON-"🎨", COLOR-#ec4899, BADGE-"DESIGN" },
        { USE-Card, TITLE-"Reactive", BODY-"STATE badlo aur RERENDER() call karo — UI khud update ho jayegi.", ICON-"⚡", COLOR-#10b981, BADGE-"STATE" }
