  {
    TAG-header,
    DI-flex,
    JUS-space-between,
    ALI-center,
    PA-16px 24px,
    BG-#0f172a,
    COL-#ffffff,
    BOX-0 4px 20px rgba(0,0,0,0.25),
    POS-relative,
    ZIN-10,

    {
      DI-flex,
      ALI-center,
      GAP-12px,
      {
        TEXT-"⚡",
        FON-1.8rem
      },
      {
        TEXT-"Rind.js",
        COL-#6366f1,
        FON-1.6rem,
        FONW-bold
      },
      {
        TEXT-"Dashboard",
